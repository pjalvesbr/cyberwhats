; ============================================================
;  frases.cws — Frases, ações e kicks do CyberScript 3.2
;  CyberWhats Script: edite à vontade (Alt+R abre o editor).
;  As frases aleatórias ficam na pasta frases\ (um texto por linha).
; ============================================================

; /frase [categoria]  — manda uma frase aleatória no canal/pvt ativo
alias frase {
  if ($1 == $null) {
    echo -a *** Categorias: advogado bebado cretinas cumulos dquits frases ingles legais paixao peido poesias pontinho quits sogra taglines
    echo -a *** Uso: /frase cumulos
    halt
  }
  if (!$exists(frases/ $+ $1 $+ .txt)) { echo -a *** Categoria desconhecida: $1 | halt }
  say $titulo($1) $read(frases/ $+ $1 $+ .txt)
}

; títulos usados pelo CyberScript antes de cada frase
alias -l titulo {
  if ($1 == advogado) return - Advogados -
  if ($1 == cretinas) return - Piadas -
  if ($1 == ingles) return - Aula de inglês -
  if ($1 == peido) return - Peido -
  if ($1 == sogra) return - Sogras -
  return
}

; /kickfrase <nick>  — kicka (remove do grupo) com uma frase aleatória de kick
alias kickfrase {
  if (# == $null) { echo -a *** Use dentro de um canal. | halt }
  if ($1 == $null) { echo -a *** Uso: /kickfrase <nick> | halt }
  say $1 foi kickado: $read(frases/kicks.txt)
  kick # $1
}

; /quitfrase  — mostra uma frase de quit (sem sair de nada)
alias quitfrase say $read(frases/quits.txt)

