{
  "name": "cyberwhats",
  "productName": "CyberWhats",
  "version": "3.2.0",
  "description": "Cliente WhatsApp no estilo CyberScript 3.2",
  "main": "src/main.mjs",
  "type": "module",
  "author": "Paulo Alves",
  "license": "MIT AND GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "versao": "node tools/versao.mjs",
    "test": "node --test tests/unit.test.mjs",
    "test:ui": "node tests/smoke.cjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  },
  "build": {
    "appId": "org.cyberwhats.app",
    "productName": "CyberWhats",
    "copyright": "Paulo Alves",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CyberWhats-3.2.0.7-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CyberWhats-3.2.0.7-setup.exe",
      "shortcutName": "CyberWhats",
      "installerIcon": "build/icon.ico"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "bin/cw-engine.exe",
        "to": "bin/cw-engine.exe"
      }
    ],
    "buildVersion": "3.2.0.7",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.CyberWhats.txt"
      },
      {
        "from": "engine-go/LICENSE",
        "to": "LICENSE.cw-engine.GPL-3.0.txt"
      }
    ]
  },
  "cwVersion": "3.2.0.7"
}
